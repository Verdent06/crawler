# Copy to .env and fill in values. .env is gitignored; never commit real keys.
# Names only here. Defaults apply when a variable is empty or unset.

# Optional model (OpenAI-compatible chat API). Empty LLM_API_KEY = keyword rules only.
# GEMINI_API_KEY / OPENAI_API_KEY are accepted if LLM_API_KEY is unset.
LLM_API_KEY=
# Leave these two commented to use the built-in Gemini defaults; an empty value disables the model.
# LLM_BASE_URL=
# LLM_MODEL=

# Shared secret for POST /scrape (X-API-Key header). Empty = no auth (local dev only).
SCRAPER_API_KEY=

# Per-client POST /scrape requests per minute (default 10, 0 disables).
SCRAPE_RATE_LIMIT_PER_MINUTE=

# Trust Cloudflare/Render client-IP headers for the scrape rate limiter.
# Off by default so X-Forwarded-For cannot be spoofed on a direct connection.
# render.yaml sets this to 1 on Render. Leave unset locally.
TRUST_FORWARDED_FOR=

# Crawls allowed to run at once (default 3, 0 disables the cap).
MAX_CONCURRENT_SCRAPES=

# Set to 1 to resolve hostnames via the nameservers in /etc/resolv.conf when the
# OS resolver fails (broken macOS stub resolver). Off by default.
DNS_FALLBACK=
